rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/private/profile {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name','birth','updatedAt','schemaVersion'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.birth is string && request.resource.data.birth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
